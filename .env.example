# Port (optional — defaults to 3000)
PORT=3000

# ── Direct API tokens (UTCP-style, no MCP proxy needed) ──────────────────
# AI: no key needed — uses your existing Claude Code CLI auth

# Gmail (OAuth access token from Google Cloud Console)
GMAIL_ACCESS_TOKEN=ya29...

# Google Calendar (can reuse same OAuth token if scopes include calendar)
GCAL_ACCESS_TOKEN=ya29...

# Notion (Internal Integration Token from notion.so/my-integrations)
NOTION_TOKEN=secret_...

# Google Drive (OAuth access token)
GDRIVE_ACCESS_TOKEN=ya29...

# ── How to get Google OAuth tokens quickly ───────────────────────────────
# 1. Go to https://developers.google.com/oauthplayground
# 2. Select scopes: Gmail readonly, Calendar readonly, Drive readonly
# 3. Authorize and copy the access token (valid ~1 hour)
# 4. For long-lived tokens, set up a service account or OAuth refresh flow
