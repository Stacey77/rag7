# Shared OpenAI API key (used by the Python agents and optional Netlify proxy)
OPENAI_API_KEY=your-openai-api-key-here

# Python GPT-4 agent settings
GPT4_MODEL=gpt-4
GPT4_MAX_TOKENS=2048
GPT4_TEMPERATURE=0.7

# Python fusion layer settings
FUSION_STRATEGY=consensus
FUSION_SEPARATOR=\n\n---\n\n
FUSION_WEIGHTS=gpt4:1.0,claude:0.9,gemini:0.8

# Python logging
LOG_LEVEL=INFO
LOG_FILE=rag7.log

# Optional Netlify server-side AI proxy settings
OPENAI_MODEL=gpt-4o-mini
ALLOWED_ORIGIN=https://stacey77.github.io
