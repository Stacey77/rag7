# Server-side AI proxy – Netlify configuration
#
# Copy this file to `server/.env` and fill in your values.
# NEVER commit the actual .env file to version control.

# Required – your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional – which model to use (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional – CORS allowed origin (defaults to the GitHub Pages URL)
# Set to http://localhost:PORT for local development
ALLOWED_ORIGIN=https://stacey77.github.io
