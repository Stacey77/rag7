# Ragamuffin Production Environment Variables
# Copy this file to .env.production and fill in the values

# Service Ports
LANGFLOW_PORT=7860
BACKEND_PORT=8000
FRONTEND_PORT=8080
LANGGRAPH_PORT=7878

# Backend Configuration
ENVIRONMENT=production
FLOWS_DIR=/app/flows
MAX_INPUT_LENGTH=10000

# CORS Configuration
# Comma-separated list of allowed origins (no spaces)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend API URL
VITE_API_URL=https://api.yourdomain.com

# Security - JWT Authentication
ENABLE_AUTH=true
# IMPORTANT: Generate a strong secret key for production
# Use: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-me
JWT_SECRET=your-jwt-secret-here-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Database Configuration (Optional - for persistent storage)
# PostgreSQL example: postgresql://user:password@localhost:5432/ragamuffin
# MongoDB example: mongodb://user:password@localhost:27017/ragamuffin
DATABASE_URL=

# Logging
LOG_LEVEL=INFO

# Rate Limiting (requests per minute)
RATE_LIMIT=100

# File Upload Limits (in MB)
MAX_UPLOAD_SIZE=10
